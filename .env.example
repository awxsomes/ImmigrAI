# Copy to .env.local and fill in. Never commit real keys.
# OpenRouter API key (https://openrouter.ai/keys). Set a spend limit on the key in the OpenRouter dashboard.
OPENROUTER_API_KEY=
# Cheap model used for recommendations and discovery (any OpenRouter model id).
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Model used with OpenRouter's web plugin for live discovery.
OPENROUTER_SEARCH_MODEL=anthropic/claude-haiku-5.5
# Hard cap on AI calls per day across the whole app (spend cap). 0 disables AI features.
AI_DAILY_CALL_CAP=400
# Per-visitor AI requests per minute.
AI_RATE_LIMIT_PER_MINUTE=12
# Public URL of the deployment, used for CORS/CSRF origin checks.
APP_URL=http://localhost:3000
# Public contact address shown on legal pages. Leave empty until you have one.
NEXT_PUBLIC_CONTACT_EMAIL=
